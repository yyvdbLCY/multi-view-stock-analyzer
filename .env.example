# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of allowed Telegram user IDs (numeric). Get yours from @userinfobot
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ===== Gemini (Google AI Studio) =====
GEMINI_API_KEY=your_gemini_api_key_here
# Model names (defaults: gemini-2.0-flash for both layers)
GEMINI_MODEL_EXTRACT=gemini-2.0-flash
GEMINI_MODEL_EVAL=gemini-2.0-flash

# ===== YouTube Data API v3 =====
# Get one at https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ===== Storage =====
DB_PATH=db/analyzer.db
REPORTS_DIR=reports

# ===== Aggregation window =====
# How many days back to aggregate mentions for a ticker
AGGREGATION_WINDOW_DAYS=7

# ===== Optional: Whisper fallback =====
# Only used if YouTube Data API captions endpoint returns 403
# (requires ffmpeg + ~150MB openai-whisper package — not recommended on Vercel)
WHISPER_MODEL=base
ENABLE_WHISPER_FALLBACK=false
