# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of allowed Telegram user IDs (numeric). Get yours from @userinfobot
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ===== Gemini (Google AI Studio) =====
GEMINI_API_KEY=your_gemini_api_key_here
# Model names (defaults: gemini-2.0-flash for both layers)
GEMINI_MODEL_EXTRACT=gemini-2.0-flash
GEMINI_MODEL_EVAL=gemini-2.0-flash

# ===== ScraperAPI (bypasses YouTube datacenter IP block) =====
# Get a key at https://www.scraperapi.com/ (free tier: 1000 calls/month)
# This is the ONLY way to fetch YouTube transcripts in cloud environments,
# because YouTube blocks requests from datacenter IPs (Vercel, GitHub Actions, etc).
SCRAPER_API_KEY=your_scraperapi_key_here

# ===== Storage =====
DB_PATH=db/analyzer.db
REPORTS_DIR=reports

# ===== Aggregation window =====
# How many days back to aggregate mentions for a ticker
AGGREGATION_WINDOW_DAYS=7

# ===== Optional: Whisper fallback =====
# Only used if ScraperAPI fails entirely. Requires ffmpeg + openai-whisper
# (~150MB), so this only works locally — NOT on Vercel.
WHISPER_MODEL=base
ENABLE_WHISPER_FALLBACK=false
